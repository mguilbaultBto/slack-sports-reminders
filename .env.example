# Incoming Webhooks Slack (un par channel)
# Copier vers .env.local (pas .env) : firebase deploy charge .env comme
# variables non secrètes, en conflit avec Secret Manager.
SLACK_WEBHOOK_YOGA=https://hooks.slack.com/services/T000/B000/XXXX
SLACK_WEBHOOK_ESCALADE=https://hooks.slack.com/services/T000/B000/YYYY
SLACK_WEBHOOK_TEST=https://hooks.slack.com/services/T000/B000/ZZZZ
